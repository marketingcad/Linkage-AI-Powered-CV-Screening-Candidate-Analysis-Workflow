# LiveKit — same project as the backend (so the agent is dispatched to its rooms)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live API (native-audio model)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Where to report the finished interview (transcript) — your backend's public URL
BACKEND_URL=http://localhost:4000
# Must match the backend's AGENT_SHARED_SECRET (authorizes the completion callback)
AGENT_SHARED_SECRET=
