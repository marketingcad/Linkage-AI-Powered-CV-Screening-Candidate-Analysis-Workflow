# --- LiveKit (from your LiveKit Cloud project settings) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini Live API (a Google AI Studio key with Live API access) ---
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Express control-plane port (the web dev server proxies /api here) ---
PORT=4100

# --- Scheduling (time-gated join links) ---
SCHEDULE_SECRET=dev-schedule-secret-change-me
SCHEDULE_LEAD_MINUTES=15

# --- Recording (OPTIONAL for the first run). Supabase Storage is S3-compatible. ---
# Leave S3_BUCKET blank to skip recording and test the conversation only.
S3_BUCKET=
S3_REGION=us-east-1
# For Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
