{
  "name": "ai-interview-spike",
  "private": true,
  "type": "module",
  "description": "Phase 0 spike: AI voice interviewer (LiveKit + Gemini Live). Isolated from the main app.",
  "scripts": {
    "server": "tsx watch src/server.ts",
    "agent": "tsx src/agent.ts dev",
    "web": "vite",
    "dev": "concurrently -n server,agent,web -c blue,magenta,green \"npm run server\" \"npm run agent\" \"npm run web\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.0",
    "@livekit/agents-plugin-google": "^1.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "livekit-client": "^2.7.0",
    "livekit-server-sdk": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
